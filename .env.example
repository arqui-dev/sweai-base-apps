# Copy to .env.local and fill in. Nothing here is read outside src/env.ts.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=REPLACE

# Stripe: dashboard > developers > API keys
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
# Price of one coffee, in cents.
COFFEE_UNIT_AMOUNT=500
COFFEE_CURRENCY=usd

# Sanity: sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=REPLACE
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=REPLACE

# Resend: resend.com/api-keys
RESEND_API_KEY=re_REPLACE
RESEND_FROM="Hire Service <hello@example.com>"
RESEND_AUDIENCE_ID=REPLACE

# Shared secret for POST /api/newsletter/send and any cron trigger.
ADMIN_API_TOKEN=REPLACE
# Signs unsubscribe links. At least 32 chars: openssl rand -base64 32
NEWSLETTER_SECRET=REPLACE
