# Copy to .env.local and fill in. Nothing here is read outside src/env.ts.
#
# Every variable may be left empty. The application boots, every page renders,
# and each feature behind a missing key degrades: writes answer 503 naming what
# is unset, reads log and fall back. Empty secrets are replaced with random
# bytes at boot, never with the placeholder values committed here, so every
# signature and token check fails closed rather than accepting a value anyone
# could read out of this repository.
#
# On Vercel, NEXT_PUBLIC_SITE_URL falls back to the deployment URL, so a
# preview works without setting it. Production should still set the real
# domain: Stripe redirects and magic-link callbacks are built from it.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: project settings > API keys
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE.supabase.co
# "sb_publishable_..." Ships to the browser by design; row level security is
# what protects the data behind it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
# "sb_secret_..." Bypasses row level security. Server only, and never prefixed
# with NEXT_PUBLIC_. Both variables are prefix-checked at boot.
SUPABASE_SECRET_KEY=sb_secret_REPLACE

# Stripe: dashboard > developers > API keys
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
# Price of one coffee, in cents.
COFFEE_UNIT_AMOUNT=500
COFFEE_CURRENCY=usd

# Sanity: sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=REPLACE
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=REPLACE
# Optional. The hosted Studio address printed by `npx sanity deploy`, e.g.
# https://arqui-dev.sanity.studio. The footer link appears only when set.
NEXT_PUBLIC_SANITY_STUDIO_URL=

# Resend: resend.com/api-keys
RESEND_API_KEY=re_REPLACE
RESEND_FROM="Hire Service <hello@example.com>"
RESEND_AUDIENCE_ID=REPLACE

# Shared secret for POST /api/newsletter/send and any cron trigger.
ADMIN_API_TOKEN=REPLACE
# Signs unsubscribe links. At least 32 chars: openssl rand -base64 32
NEWSLETTER_SECRET=REPLACE
